<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Margin="14" CornerRadius="18" Background="#14161B" BorderBrush="#262A33" BorderThickness="1"
        TextElement.Foreground="#E8EAEE" TextElement.FontFamily="Segoe UI Variable Text, Segoe UI" TextElement.FontSize="13">
  <Border.Effect>
    <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.6" Color="Black"/>
  </Border.Effect>
  <Border.Resources><!--THEME--></Border.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid x:Name="TitleBar" Background="Transparent">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0" IsHitTestVisible="False">
        <Border Width="20" Height="20" CornerRadius="6" Background="#2FB36E" Margin="0,0,10,0">
          <TextBlock Text="&#xE701;" FontFamily="{StaticResource Icons}" FontSize="11" Foreground="White"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <TextBlock Text="Пинг" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
        <TextBlock Text="  by mysik" Foreground="#6E7584" FontSize="12" VerticalAlignment="Center" Margin="0,1,0,0"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
        <Button x:Name="MinBtn" Style="{StaticResource TitleBtn}" Content="&#xE921;" ToolTip="Свернуть"/>
        <Button x:Name="CloseBtn" Style="{StaticResource TitleBtn}" Content="&#xE8BB;" ToolTip="Закрыть"/>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,4,4,12">
      <StackPanel Margin="16,0,12,8">

        <!-- общий статус -->
        <Border Background="#1C1F26" CornerRadius="16" Padding="18,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="46" Height="46" Margin="0,0,14,0">
              <Ellipse x:Name="StatusGlow" Fill="#2FB36E" Opacity="0.22"/>
              <Ellipse x:Name="StatusDot" Width="18" Height="18" Fill="#2FB36E"/>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="StatusTitle" Text="Проверяю связь…" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock x:Name="StatusSub" Text="" Style="{StaticResource Hint}"/>
            </StackPanel>
          </Grid>
        </Border>

        <!-- большой график -->
        <Border Background="#1C1F26" CornerRadius="16" Padding="14,12" Margin="0,10,0,0">
          <StackPanel>
            <Grid>
              <TextBlock x:Name="ChartTitle" Text="" FontWeight="SemiBold"/>
              <TextBlock x:Name="ChartStats" Text="" Foreground="#8B92A0" FontSize="12" HorizontalAlignment="Right"/>
            </Grid>
            <Canvas x:Name="Chart" Height="150" Margin="0,10,0,0" ClipToBounds="True"/>
            <TextBlock Text="последние 5 минут · красные отметки — потерянные пакеты" Foreground="#6E7584" FontSize="11" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>

        <TextBlock Text="СЕРВЕРЫ" Style="{StaticResource Caption}" Margin="4,20,0,8"/>
        <Border Background="#1C1F26" CornerRadius="14" Padding="6">
          <StackPanel>
            <StackPanel x:Name="TargetList"/>
            <Grid Margin="6,8,6,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid>
                <TextBlock x:Name="AddPlaceholder" Text="Сайт или IP, например steamcommunity.com" Foreground="#6E7584" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Panel.ZIndex="1"/>
                <TextBox x:Name="AddBox" Style="{StaticResource InputBox}"/>
              </Grid>
              <Button x:Name="AddBtn" Grid.Column="2" Style="{StaticResource SecondaryBtn}" Background="#262A33" Padding="14,8" Content="Добавить"/>
            </Grid>
          </StackPanel>
        </Border>

        <Grid Margin="4,20,0,8">
          <TextBlock Text="ОБРЫВЫ" Style="{StaticResource Caption}" Margin="0" VerticalAlignment="Center"/>
          <Button x:Name="ReportBtn" Style="{StaticResource SecondaryBtn}" Background="Transparent" Padding="8,4"
                  HorizontalAlignment="Right" Foreground="#2FB36E" Content="Сохранить отчёт"/>
        </Grid>
        <Border Background="#1C1F26" CornerRadius="14" Padding="14,6">
          <StackPanel>
            <StackPanel x:Name="OutageList"/>
            <TextBlock x:Name="OutageEmpty" Text="Пока ни одного обрыва — связь стабильная" Foreground="#8B92A0"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,14"/>
          </StackPanel>
        </Border>

        <TextBlock Text="НАСТРОЙКИ" Style="{StaticResource Caption}" Margin="4,20,0,0"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <CheckBox x:Name="SwNotify" Style="{StaticResource Switch}">
              <StackPanel>
                <TextBlock Text="Сообщать об обрывах" FontWeight="SemiBold"/>
                <TextBlock Text="Уведомление, когда интернет пропал и когда вернулся" Style="{StaticResource Hint}"/>
              </StackPanel>
            </CheckBox>
            <Border Style="{StaticResource Separator}"/>
            <CheckBox x:Name="SwAutostart" Style="{StaticResource Switch}">
              <StackPanel>
                <TextBlock Text="Следить постоянно" FontWeight="SemiBold"/>
                <TextBlock Text="Запускаться вместе с Windows и вести журнал в трее" Style="{StaticResource Hint}"/>
              </StackPanel>
            </CheckBox>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Hint}" Margin="4,0,4,4">
          <Run Text="Пинг"/>
          <Run x:Name="Signature" Text="by mysik" Foreground="#2FB36E" FontWeight="SemiBold" Cursor="Hand"/>
        </TextBlock>
      </StackPanel>
    </ScrollViewer>

    <Border x:Name="Snack" Grid.Row="0" Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Margin="20,0,20,22" Padding="16,11" CornerRadius="12" Background="#2A2E38" BorderBrush="#363B47" BorderThickness="1"
            Opacity="0" IsHitTestVisible="False">
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" Color="Black"/>
      </Border.Effect>
      <TextBlock x:Name="SnackText" Text="" TextWrapping="Wrap" MaxWidth="320"/>
    </Border>

    <Grid x:Name="Overlay" Grid.Row="0" Grid.RowSpan="3" Background="#B30B0C10" Visibility="Collapsed">
      <Border Width="330" Background="#1E2128" CornerRadius="16" Padding="20" BorderBrush="#2E333E" BorderThickness="1"
              VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
          <TextBlock x:Name="DlgTitle" Text="" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="DlgText" Text="" Style="{StaticResource Hint}" FontSize="13" Margin="0,8,0,0"/>
          <Grid Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="DlgNo" Style="{StaticResource SecondaryBtn}" Background="#2A2E38" Content="Отмена"/>
            <Button x:Name="DlgYes" Grid.Column="2" Style="{StaticResource PrimaryBtn}" Content="OK"/>
          </Grid>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Border>
